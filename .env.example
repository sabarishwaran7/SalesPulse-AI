# ==============================================================================
# SalesPulse AI - Environment Configuration
# ==============================================================================

# Database Connection (Supabase PostgreSQL in production, SQLite for local dev)
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./salespulse.db

# Groq AI Credentials & Model Configuration
# Obtain your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Confidence Routing Threshold (0.0 to 1.0)
# Predictions below this threshold route automatically to the AI Review Center
CONFIDENCE_THRESHOLD=0.75

# File Upload Limits
MAX_UPLOAD_SIZE_MB=25

# Frontend Base URL (used in frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
